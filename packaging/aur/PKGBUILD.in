# Maintainer: hyperpuncher

pkgname=rift-clipboard-bin
pkgver={{VERSION}}
pkgrel=1
pkgdesc='Lightweight multi-format clipboard manager for Wayland'
arch=('x86_64' 'aarch64')
url='https://github.com/hyperpuncher/rift'
license=('MIT')
depends=('glibc' 'libgcc')
install=rift.install
provides=('rift')
conflicts=('rift' 'rift-bin')
source_x86_64=("$pkgname-$pkgver-$CARCH.tar.gz::$url/releases/download/v$pkgver/rift-linux-x64.tar.gz")
source_aarch64=("$pkgname-$pkgver-$CARCH.tar.gz::$url/releases/download/v$pkgver/rift-linux-arm64.tar.gz")
sha256sums_x86_64=('{{SHA_X64}}')
sha256sums_aarch64=('{{SHA_ARM64}}')

package() {
	install -Dm755 rift "$pkgdir/usr/bin/rift"
	install -Dm644 rift.service "$pkgdir/usr/lib/systemd/user/rift.service"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
